{
  "name": "@velvet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "build": "esbuild src/main.ts src/db/migrate.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --external:@node-rs/argon2 --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outdir=dist --entry-names=[name]",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@node-rs/argon2": "2.2.1",
    "@velvet/game-math": "workspace:*",
    "@velvet/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.10",
    "tsx": "4.20.6"
  }
}
