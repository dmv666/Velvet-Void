# Copia a .env. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=3000
# Origen exacto del cliente (CORS y comprobación de Origin).
CLIENT_ORIGIN=http://localhost:5173
# El servidor se conecta con el rol de mínimo privilegio.
DATABASE_URL=postgres://velvet_app:app_dev_only@127.0.0.1:5432/velvet_void
# Las migraciones usan el rol dueño del esquema.
MIGRATION_DATABASE_URL=postgres://velvet_owner:owner_dev_only@127.0.0.1:5432/velvet_void
# 32 bytes en hex para cifrar las serverSeeds en reposo: openssl rand -hex 32
SEED_ENCRYPTION_KEY=
