# Imagen del servidor (Fly.io / Railway). Contexto: raíz del monorepo.
#   docker build -f Dockerfile.server -t velvet-void-api .
FROM node:22.20.0-slim AS build
WORKDIR /app
RUN corepack enable
# Primero solo los manifiestos: la capa de dependencias se cachea mientras no cambie el lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/game-math/package.json packages/game-math/
COPY packages/shared/package.json packages/shared/
COPY packages/server/package.json packages/server/
COPY packages/client/package.json packages/client/
RUN pnpm install --frozen-lockfile --filter "@velvet/server..."
COPY packages/game-math packages/game-math
COPY packages/shared packages/shared
COPY packages/server packages/server
RUN pnpm --filter @velvet/server build \
 && pnpm --filter @velvet/server deploy --prod --legacy /out

FROM node:22.20.0-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 MIGRATIONS_DIR=/app/drizzle
WORKDIR /app
# El bundle incluye casi todo; node_modules solo aporta el binario nativo de argon2.
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /app/packages/server/dist ./dist
COPY --from=build /app/packages/server/drizzle ./drizzle
USER node
EXPOSE 8080
CMD ["node", "--enable-source-maps", "dist/main.js"]
